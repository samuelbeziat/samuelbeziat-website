---
const year = new Date().getFullYear();
---

<footer class="site-footer">

  <div class="footer-cta">
    <p class="footer-tagline">LET'S WORK TOGETHER</p>
    <a href="mailto:beziatsamuel@gmail.com" class="footer-email">
      BEZIATSAMUEL@GMAIL.COM
    </a>
  </div>

  <div class="footer-bar">
    <span>SAMUEL BEZIAT</span>
    <span>{year}</span>
  </div>

  <!-- Liens secondaires mobiles : sous la barre, 3 colonnes comme le header -->
  <nav class="footer-mobile-nav" aria-label="Navigation secondaire">
    <a href="mailto:beziatsamuel@gmail.com">MAIL</a>
    <a href="https://www.linkedin.com/in/samuel-beziat18/" target="_blank" rel="noopener noreferrer">LINKEDIN</a>
    <a href="https://www.instagram.com/samuelbeziat_" target="_blank" rel="noopener noreferrer">IG</a>
  </nav>

</footer>

<style>
  .site-footer {
    padding: 0 var(--pad-x);
    margin-top: var(--section-gap);
  }

  .footer-cta {
    text-align: center;
    padding: calc(var(--section-gap) * 0.7) 0 calc(var(--section-gap) * 0.4);
  }

  .footer-tagline {
    font-size: clamp(0.7rem, 1vw, 1rem);
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    letter-spacing: var(--ls-caps);
    line-height: 1.1;
  }

  .footer-email {
    font-size: clamp(1rem, 1.8vw, 1.9rem);
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    letter-spacing: var(--ls-caps);
    display: inline-block;
    margin-top: 0.1em;
    transition: opacity var(--t-fast);
  }

  .footer-email:hover { opacity: 0.5; }

  .footer-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 0 0;
    font-size: var(--size-header);
    text-transform: uppercase;
    letter-spacing: var(--ls-caps);
    font-weight: var(--fw-regular);
  }


  /* Mobile nav : caché sur desktop */
  .footer-mobile-nav {
    display: none;
  }

  @media (max-width: 900px) {
    /* 3 colonnes égales, même taille et style que la barre footer.
       MAIL : sous SAMUEL (gauche)
       LINKEDIN : centre
       IG : sous 2026 (droite) */
    .footer-mobile-nav {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      padding: 0.4rem 0 1.2rem;
      font-size: var(--size-header);
      text-transform: uppercase;
      letter-spacing: var(--ls-caps);
      font-weight: var(--fw-regular);
    }

    .footer-mobile-nav a:nth-child(1) { text-align: left; }
    .footer-mobile-nav a:nth-child(2) { text-align: center; }
    .footer-mobile-nav a:nth-child(3) { text-align: right; }
  }
</style>
