<button id="lang-switcher" class="lang-btn" aria-label="Switch language">FR</button>

<style>
  .lang-btn {
    position: fixed;
    bottom: var(--pad-x);
    left: var(--pad-x);
    z-index: 200;

    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
    border: none;
    cursor: pointer;

    font-family: var(--font);
    font-size: var(--size-header);
    font-weight: var(--fw-regular);
    text-transform: uppercase;
    letter-spacing: var(--ls-caps);

    display: flex;
    align-items: center;
    justify-content: center;

    transition: opacity var(--t-fast);
  }

  .lang-btn:hover {
    opacity: 0.7;
  }

  /* S'efface quand il passe par-dessus un lien du footer */
  .lang-btn.is-covering {
    opacity: 0;
    pointer-events: none;
  }
</style>

<script>
  const btn = document.getElementById('lang-switcher') as HTMLButtonElement;

  function applyLang(lang: string) {
    document.documentElement.dataset.lang = lang;
    document.documentElement.lang = lang;
    localStorage.setItem('sb-lang', lang);
    btn.textContent = lang === 'fr' ? 'FR' : 'EN';
  }

  const saved = localStorage.getItem('sb-lang') || 'fr';
  applyLang(saved);

  btn.addEventListener('click', () => {
    const next = document.documentElement.dataset.lang === 'fr' ? 'en' : 'fr';
    applyLang(next);
  });

  /* ── Masquage au-dessus du footer ──────────────────────────────
   * Le bouton est fixe : en scrollant, il passe sur les liens du footer.
   * On le cache uniquement quand il chevauche réellement un lien
   * (marge de 6px), il revient dès que la zone est libre.
   */
  const footerTargets = Array.from(
    document.querySelectorAll<HTMLElement>('.footer-links a, .footer-links span'),
  );
  let ticking = false;

  function checkOverlap() {
    ticking = false;
    const b = btn.getBoundingClientRect();
    const m = 6;
    const covering = footerTargets.some(el => {
      const r = el.getBoundingClientRect();
      if (r.width === 0) return false; // libellé de l'autre langue (masqué)
      return r.left < b.right + m && r.right > b.left - m
          && r.top < b.bottom + m && r.bottom > b.top - m;
    });
    btn.classList.toggle('is-covering', covering);
  }

  function requestCheck() {
    if (!ticking) { ticking = true; requestAnimationFrame(checkOverlap); }
  }

  window.addEventListener('scroll', requestCheck, { passive: true });
  window.addEventListener('resize', requestCheck);
  btn.addEventListener('click', requestCheck);
  requestCheck();
</script>
