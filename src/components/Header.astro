---
import Logo from './Logo.astro';
import { withBase } from '../utils/url';
const path = Astro.url.pathname;
const isAbout   = path.includes('/about');
const isContact = path.includes('/contact');
const isSign    = path.includes('/peinture-en-lettre');
const isWork    = !isAbout && !isContact && !isSign;
---

<header class="site-header">

  <a href={withBase('/')} class="hd-logo">
    <Logo class="hd-logo-mark" />
    <span class="hd-logo-text">SAMUEL BEZIAT</span>
  </a>

  <button class="hd-burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="hd-nav">
    <span></span><span></span><span></span>
  </button>

  <nav class="hd-nav" id="hd-nav">
    <a href={withBase('/')} class:list={['hd-pill', { 'is-active': isWork }]}>
      <span data-lang-fr>TRAVAUX</span>
      <span data-lang-en>WORK</span>
    </a>
    <a href={withBase('/peinture-en-lettre')} class:list={['hd-pill', { 'is-active': isSign }]}>
      <span data-lang-fr>PEINTURE EN LETTRE</span>
      <span data-lang-en>SIGN PAINTING</span>
    </a>
    <a href={withBase('/about')} class:list={['hd-pill', { 'is-active': isAbout }]}>
      <span data-lang-fr>À&nbsp;PROPOS</span>
      <span data-lang-en>ABOUT</span>
    </a>
    <a href={withBase('/contact')} class:list={['hd-pill', { 'is-active': isContact }]}>CONTACT</a>
  </nav>

</header>

<style>
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: var(--header-h);
    padding: 0.65rem var(--pad-x);
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    font-size: var(--size-header);
    text-transform: uppercase;
    letter-spacing: var(--ls-caps);
    font-weight: var(--fw-regular);
  }

  /* ── Logo : pas d'encadré, picto plus gros ───────────────────── */

  .hd-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
    font-weight: var(--fw-light);
  }

  .hd-logo :global(.hd-logo-mark) {
    display: block;
    height: 2.2em;
    width: auto;
    flex-shrink: 0;
  }

  .hd-logo-text {
    font-family: var(--font-henry);
    font-size: 1.5em;
    font-weight: 400;
    letter-spacing: normal;
  }

  /* ── Nav : encarts carrés, fond plein, pas de contour ────────── */

  .hd-nav {
    display: flex;
    gap: 0.5rem;
  }

  .hd-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.9rem;
    background: rgba(0, 0, 0, 0.05);
    white-space: nowrap;
    transition: background var(--t-fast), color var(--t-fast);
  }

  .hd-pill:hover,
  .hd-pill.is-active {
    background: var(--accent);
    color: var(--accent-ink);
  }

  /* ── Burger (mobile uniquement) ─────────────────────────────── */

  .hd-burger {
    display: none;
  }

  /* ── Mobile ───────────────────────────────────────────────────── */

  /* Nom + 4 boutons ne tiennent pas sur une ligne : logo + nom à gauche,
     burger à droite, la nav devient un menu déroulant rouge. */
  @media (max-width: 720px) {
    .hd-burger {
      display: inline-flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 2.6rem;
      height: 2.6rem;
      padding: 0 0.65rem;
      background: var(--accent);
      border: none;
      cursor: pointer;
    }

    .hd-burger span {
      display: block;
      height: 2px;
      background: var(--accent-ink);
      transition: transform var(--t-fast), opacity var(--t-fast);
    }

    .site-header.is-open .hd-burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .site-header.is-open .hd-burger span:nth-child(2) { opacity: 0; }
    .site-header.is-open .hd-burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    .hd-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      background: var(--accent);
      padding: 0.5rem var(--pad-x) 1rem;
    }

    .site-header.is-open .hd-nav {
      display: flex;
    }

    .hd-pill {
      background: none;
      color: var(--accent-ink);
      font-size: 1.4em;
      padding: 0.9rem 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.35);
    }

    .hd-pill:last-child {
      border-bottom: none;
    }

    .hd-pill:hover,
    .hd-pill.is-active {
      background: none;
      color: var(--accent-ink);
    }

    .hd-pill.is-active {
      text-decoration: underline;
      text-underline-offset: 0.3em;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const burger = header?.querySelector<HTMLButtonElement>('.hd-burger');

  if (header && burger) {
    const setOpen = (open: boolean) => {
      header.classList.toggle('is-open', open);
      burger.setAttribute('aria-expanded', String(open));
    };

    burger.addEventListener('click', () => setOpen(!header.classList.contains('is-open')));
    header.querySelectorAll('.hd-pill').forEach(a => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', e => { if (e.key === 'Escape') setOpen(false); });
    document.addEventListener('click', e => { if (!header.contains(e.target as Node)) setOpen(false); });
  }
</script>
