---
import Logo from './Logo.astro';
import { withBase } from '../utils/url';
const path = Astro.url.pathname;
const isAbout   = path.includes('/about');
const isContact = path.includes('/contact');
const isSign    = path.includes('/peinture-en-lettre');
const isWork    = !isAbout && !isContact && !isSign;
---

<header class="site-header">

  <a href={withBase('/')} class="hd-logo">
    <Logo class="hd-logo-mark" />
    <span class="hd-logo-text">SAMUEL BEZIAT</span>
  </a>

  <nav class="hd-nav">
    <a href={withBase('/')} class:list={['hd-pill', { 'is-active': isWork }]}>
      <span data-lang-fr>TRAVAUX</span>
      <span data-lang-en>WORK</span>
    </a>
    <a href={withBase('/peinture-en-lettre')} class:list={['hd-pill', { 'is-active': isSign }]}>
      <span data-lang-fr>PEINTURE EN LETTRE</span>
      <span data-lang-en>SIGN PAINTING</span>
    </a>
    <a href={withBase('/about')} class:list={['hd-pill', { 'is-active': isAbout }]}>
      <span data-lang-fr>À&nbsp;PROPOS</span>
      <span data-lang-en>ABOUT</span>
    </a>
    <a href={withBase('/contact')} class:list={['hd-pill', { 'is-active': isContact }]}>CONTACT</a>
  </nav>

</header>

<style>
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: var(--header-h);
    padding: 0.65rem var(--pad-x);
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    font-size: var(--size-header);
    text-transform: uppercase;
    letter-spacing: var(--ls-caps);
    font-weight: var(--fw-regular);
  }

  /* ── Logo : pas d'encadré, picto plus gros ───────────────────── */

  .hd-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
    font-weight: var(--fw-light);
  }

  .hd-logo :global(.hd-logo-mark) {
    display: block;
    height: 2.2em;
    width: auto;
    flex-shrink: 0;
  }

  .hd-logo-text {
    font-family: var(--font-henry);
    font-size: 1.5em;
    font-weight: 400;
    letter-spacing: normal;
  }

  /* ── Nav : encarts carrés, fond plein, pas de contour ────────── */

  .hd-nav {
    display: flex;
    gap: 0.5rem;
  }

  .hd-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.9rem;
    background: rgba(0, 0, 0, 0.05);
    white-space: nowrap;
    transition: background var(--t-fast), color var(--t-fast);
  }

  .hd-pill:hover,
  .hd-pill.is-active {
    background: var(--accent);
    color: var(--accent-ink);
  }

  /* ── Mobile ───────────────────────────────────────────────────── */

  /* Nom + 4 boutons ne tiennent plus sur une ligne : le header passe
     sur deux rangs (logo + nom, puis la nav sur toute la largeur). */
  @media (max-width: 720px) {
    .site-header {
      flex-wrap: wrap;
      row-gap: 0.6rem;
    }

    .hd-nav {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.35rem;
      width: 100%;
    }

    .hd-pill {
      justify-content: center;
      text-align: center;
      white-space: normal; /* "PEINTURE EN LETTRE" passe sur 2 lignes si besoin */
      line-height: 1.25;
      padding: 0.5rem 0.4rem;
    }
  }
</style>
