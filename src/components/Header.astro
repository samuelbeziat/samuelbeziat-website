---
import Logo from './Logo.astro';
import { withBase } from '../utils/url';
const path = Astro.url.pathname;
const isAbout   = path.includes('/about');
const isContact = path.includes('/contact');
const isWork    = !isAbout && !isContact;
---

<header class="site-header">

  <a href={withBase('/')} class="hd-logo">
    <Logo class="hd-logo-mark" />
    <span class="hd-logo-text">SAMUEL BEZIAT</span>
  </a>

  <nav class="hd-nav">
    <a href={withBase('/')} class:list={['hd-pill', { 'is-active': isWork }]}>
      <span data-lang-fr>TRAVAUX</span>
      <span data-lang-en>WORK</span>
    </a>
    <a href={withBase('/about')} class:list={['hd-pill', { 'is-active': isAbout }]}>
      <span data-lang-fr>À PROPOS</span>
      <span data-lang-en>ABOUT</span>
    </a>
    <a href={withBase('/contact')} class:list={['hd-pill', { 'is-active': isContact }]}>CONTACT</a>
  </nav>

</header>

<style>
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: var(--header-h);
    padding: 0.65rem var(--pad-x);
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    font-size: var(--size-header);
    text-transform: uppercase;
    letter-spacing: var(--ls-caps);
    font-weight: var(--fw-regular);
  }

  /* ── Logo : pas d'encadré, picto plus gros ───────────────────── */

  .hd-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
    font-weight: var(--fw-light);
  }

  .hd-logo :global(.hd-logo-mark) {
    display: block;
    height: 2.2em;
    width: auto;
    flex-shrink: 0;
  }

  /* ── Nav : encarts carrés, fond plein, pas de contour ────────── */

  .hd-nav {
    display: flex;
    gap: 0.5rem;
  }

  .hd-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.9rem;
    background: rgba(0, 0, 0, 0.05);
    white-space: nowrap;
    transition: background var(--t-fast), color var(--t-fast);
  }

  .hd-pill:hover,
  .hd-pill.is-active {
    background: var(--accent);
    color: var(--accent-ink);
  }

  /* ── Mobile ───────────────────────────────────────────────────── */

  @media (max-width: 480px) {
    .hd-nav { gap: 0.35rem; }
    .hd-pill { padding: 0.45rem 0.6rem; }
    /* Le nom complet + les 3 libellés FR ("À PROPOS") ne tiennent plus
       sur une seule ligne à cette largeur : on ne garde que le picto. */
    .hd-logo-text { display: none; }
  }
</style>
