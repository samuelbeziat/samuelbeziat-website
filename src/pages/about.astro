---
import Base from '../layouts/Base.astro';
import HoloCard from '../components/HoloCard.astro';
import { withBase } from '../utils/url';

const bioFr = `DA junior basé à Biarritz : identité de marque, univers graphiques, objets de mondes imaginaires. J'aime construire des systèmes visuels clairs, où chaque couleur a un rôle.

Que votre projet soit bien réel ou totalement fictif, mon approche reste la même : bien vous écouter pour bien vous traduire.`;

const bioEn = `Junior Artistic Director based in Biarritz : brand identity, visual worlds, props from imaginary universes. I like building clear systems where every colour earns its place.

Real project or fully fictional one, my approach stays the same : listening closely to translate you clearly.`;
---

<Base
  title="À propos — Samuel Beziat, Graphiste & DA à Biarritz (BAB)"
  description="Samuel Beziat, graphiste et directeur artistique (DA) basé à Biarritz (BAB), spécialisé en identité de marque et props design."
>
  <section class="about">

    <h1 class="sr-only">Samuel Beziat — Graphiste et Directeur Artistique à Biarritz (BAB)</h1>

    <div class="about-card">
      <HoloCard src={withBase('/images/portrait.jpg')} alt="Samuel Beziat" />
    </div>

    <p class="about-bio" data-lang-fr style="white-space: pre-line">{bioFr}</p>
    <p class="about-bio" data-lang-en style="white-space: pre-line">{bioEn}</p>

  </section>
</Base>

<style>
  .about {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(3rem, 6vh, 6rem) var(--pad-x) 0;
  }

  .about-card {
    margin-bottom: 3rem;
  }

  .about-bio {
    font-size: var(--size-body);
    line-height: var(--lh-body);
    font-weight: var(--fw-light);
    max-width: 54ch;
    text-align: center;
    color: var(--text);
  }

</style>
