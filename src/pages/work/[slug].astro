---
import Base from '../../layouts/Base.astro';
import ImageBlock from '../../components/ImageBlock.astro';
import { withBase } from '../../utils/url';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, year, tags, tags_en, description, description_en, blocks } = project.data;

const allProjects = await getCollection('projects');
const otherProjects = allProjects
  .filter((p) => p.slug !== project.slug && !p.data.hidden)
  .sort((a, b) => a.data.order - b.data.order);
---

<Base
  title={`${title} — Samuel Beziat`}
  description={description}
>
  <article class="project-layout">

    <!-- ── Zone titre : 1re colonne, 1re ligne ───────────────── -->
    <header class="project-title-area">
      <h1 class="project-title">{title}</h1>
      <p class="project-year">{year}</p>
    </header>

    <!-- ── Colonne droite sticky : toutes les lignes ─────────── -->
    <aside class="project-aside">
      <p class="aside-title">{title}</p>
      <p class="aside-description" data-lang-fr>{description}</p>
      <p class="aside-description" data-lang-en>{description_en ?? description}</p>
      <p class="aside-tags" data-lang-fr>{tags.join(' / ')}</p>
      <p class="aside-tags" data-lang-en>{(tags_en ?? tags).join(' / ')}</p>
    </aside>

    <!-- ── Contenu principal : images + autres projets ───────── -->
    <div class="project-main">

      {blocks && blocks.length > 0 && (
        <div class="project-blocks">
          {blocks.map((block) => (
            <ImageBlock layout={block.layout} images={block.images} />
          ))}
        </div>
      )}

      {otherProjects.length > 0 && (
        <section class="other-projects" aria-label="Autres projets">
          <p class="other-label">OTHER PROJECTS</p>
          <ul class="other-list" id="other-list">
            {otherProjects.map((p) => (
              <li class="other-item" style="display:none">
                <a href={withBase(`/work/${p.slug}`)} class="other-link">
                  <span class="other-name">{p.data.title}</span>
                  <span class="other-meta">
                    {p.data.year} — {p.data.tags.join(' / ')}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

    </div>

  </article>
</Base>

<style>
  /* ── Layout desktop : grille 2 colonnes avec zones nommées ───── */

  .project-layout {
    display: grid;
    grid-template-columns: 1fr clamp(130px, 13vw, 180px);
    grid-template-rows: auto 1fr;
    grid-template-areas:
      "title aside"
      "main  aside";
    column-gap: clamp(3rem, 5vw, 6rem);
    padding: 0 var(--pad-x);
    align-items: start;
  }

  .project-title-area { grid-area: title; }
  .project-aside      { grid-area: aside; }
  .project-main       { grid-area: main; }

  /* ── Titre ────────────────────────────────────────────────────── */

  .project-title-area {
    padding-top: 1.5rem;
    padding-bottom: var(--section-gap);
  }

  .project-title {
    font-family: var(--font-henry);
    font-style: italic;
    font-weight: 400;
    font-size: var(--size-project-page);
    text-transform: uppercase;
    letter-spacing: var(--ls-tight);
    line-height: var(--lh-display);
    color: var(--text);
  }

  .project-year {
    font-size: var(--size-body);
    text-transform: uppercase;
    letter-spacing: var(--ls-caps);
    color: var(--text);
    margin-top: 0.6rem;
    font-weight: var(--fw-regular);
  }

  /* ── Aside sticky ────────────────────────────────────────────── */

  .project-aside {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    align-self: start;
    padding-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .aside-title {
    font-size: var(--size-body);
    font-weight: var(--fw-bold);
    text-transform: uppercase;
    letter-spacing: var(--ls-tight);
    color: var(--text);
    line-height: 1.2;
  }

  .aside-description {
    font-size: var(--size-body);
    line-height: var(--lh-body);
    font-weight: var(--fw-light);
    color: var(--text);
    white-space: pre-line;
  }

  .aside-tags {
    font-size: var(--size-body);
    text-transform: uppercase;
    letter-spacing: var(--ls-caps);
    font-weight: var(--fw-regular);
    color: var(--text);
  }

  /* ── Images ──────────────────────────────────────────────────── */

  .project-blocks {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 100%;
  }

  /* ── Autres projets ──────────────────────────────────────────── */

  .other-projects {
    margin-top: var(--section-gap);
    padding-bottom: 1rem;
  }

  .other-label {
    font-size: var(--size-header);
    text-transform: uppercase;
    letter-spacing: var(--ls-caps);
    font-weight: var(--fw-regular);
    color: var(--text);
    margin-bottom: 0.6rem;
  }

  .other-list {
    display: flex;
    flex-direction: column;
  }

  .other-link {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
    padding: 0.25rem 0;
  }

  .other-name {
    font-size: clamp(0.78rem, 1.1vw, 0.95rem);
    text-transform: uppercase;
    letter-spacing: var(--ls-tight);
    font-weight: var(--fw-light);
    color: var(--text);
    transition: font-weight var(--t-fast);
  }

  .other-link:hover .other-name { font-weight: var(--fw-bold); }

  .other-meta {
    font-size: var(--size-header);
    text-transform: uppercase;
    letter-spacing: var(--ls-caps);
    font-weight: var(--fw-regular);
    color: var(--text);
  }

  /* ── Mobile ──────────────────────────────────────────────────── */
  /*
   * Tous les éléments sont des enfants DIRECTS de project-layout,
   * donc order fonctionne directement — pas besoin de display:contents.
   * Ordre : titre (1) → aside description (2) → images (3)
   */

  @media (max-width: 900px) {
    .project-layout {
      display: flex;
      flex-direction: column;
      /* align-items: stretch remet à zéro le align-items: start du desktop.
         Sans ça, les enfants flex prennent leur largeur intrinsèque (= images minuscules). */
      align-items: stretch;
      gap: 0;
      padding: 0 var(--pad-x);
    }

    .project-title-area {
      order: 1;
      padding-top: 2rem;
      padding-bottom: 1.5rem;
    }

    .project-aside {
      order: 2;
      position: static;
      padding-top: 0;
      padding-bottom: 2rem;
      gap: 0.75rem;
    }

    .project-main {
      order: 3;
      width: 100%;
      min-width: 0;
    }

    .project-title {
      font-size: clamp(2.5rem, 11vw, 5.5rem);
    }
  }
</style>

<script>
  // Sélectionne 3 projets aléatoires parmi tous les autres
  const items = Array.from(document.querySelectorAll<HTMLElement>('.other-item'));
  for (let i = items.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [items[i], items[j]] = [items[j], items[i]];
  }
  items.slice(0, 3).forEach(el => { el.style.display = ''; });

  // duo-one-third : force la droite à la même hauteur que la gauche (naturelle)
  function syncDuoOneThird() {
    document.querySelectorAll<HTMLElement>('.img-block--duo-one-third').forEach(block => {
      const left  = block.querySelector<HTMLElement>(':scope > .img-block__item:first-child');
      const right = block.querySelector<HTMLElement>(':scope > .img-block__item:last-child');
      if (!left || !right) return;
      right.style.height = left.getBoundingClientRect().height + 'px';
    });
  }
  window.addEventListener('load',   syncDuoOneThird);
  window.addEventListener('resize', syncDuoOneThird);
</script>
