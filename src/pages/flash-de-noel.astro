---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { flashs } from '../data/flashs';
import { withBase } from '../utils/url';

// Page volontairement cachée : absente du menu, du sitemap, et en noindex.
const mail = 'beziatsamuel@gmail.com';

// Images de src/assets : redimensionnées + WebP (garde la transparence des PNG)
const toSrc = async (src: ImageMetadata | string) =>
  typeof src === 'string'
    ? withBase(src)
    : (await getImage({ src, width: Math.min(src.width, 1600), format: 'webp' })).src;

const items = await Promise.all(flashs.map(async (f) => ({
  title: `Flash #${f.n}`,
  href: `mailto:${mail}?subject=${encodeURIComponent(`Flash de Noël #${f.n}`)}`,
  images: await Promise.all(f.images.map(async (img) => ({ src: await toSrc(img.src), alt: img.alt }))),
  sizes: f.sizes,
  reserve: !!f.reserve,
})));
---

<Base
  title="Flash de Noël — Samuel Beziat"
  description="Flashs de peinture pour vitrine, édition Noël. Modèles peints à la main par Samuel Beziat, Biarritz (BAB)."
  noindex
>
  <section class="flash">

    <header class="flash-head">
      <h1 class="flash-title">Flash de Noël</h1>
      <p class="flash-intro">
        <span data-lang-fr>Flashs de Noël peints à la main, directement sur votre vitrine.<br />Choisissez un modèle et un format, je m'occupe du reste.</span>
        <span data-lang-en>Hand-painted Christmas flashes, straight onto your shop window.<br />Pick a design and a size, I'll take care of the rest.</span>
      </p>
      <p class="flash-intro">
        <span data-lang-fr>Sur demande, couleurs, typo ou agencement peuvent être adaptés selon vos envies.<br />Chaque modèle est unique&nbsp;: une fois réservé, il n'est plus disponible.</span>
        <span data-lang-en>On request, colours, lettering or layout can be adapted to suit you.<br />Each design is one of a kind: once booked, it's gone.</span>
      </p>
    </header>

    <ul class="flash-grid">
      {items.map((item, idx) => (
        <li class:list={['flash-card', { 'is-reserved': item.reserve }]}>

          <div class="slider" data-slider>
            <div class="slider-track" data-track>
              {item.images.map((img, i) => (
                <button class="slider-slide" type="button" data-open={idx} data-index={i} aria-label={`Agrandir ${img.alt}`}>
                  <img src={img.src} alt={img.alt} loading="lazy" decoding="async" />
                </button>
              ))}
            </div>
            <button class="slider-arrow slider-arrow--prev" type="button" aria-label="Image précédente" data-prev>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
            </button>
            <button class="slider-arrow slider-arrow--next" type="button" aria-label="Image suivante" data-next>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
            </button>
            <div class="slider-dots" aria-hidden="true" data-dots>
              {item.images.map(() => <span class="slider-dot" />)}
            </div>
            {item.reserve && <span class="flash-stamp" aria-hidden="true"><span data-lang-fr>Réservé</span><span data-lang-en>Booked</span></span>}
          </div>

          <div class="flash-info">
            <h2 class="flash-name">{item.title}</h2>
            <p class="flash-sizes-note">
              <span data-lang-fr>Largeur · hauteur proportionnelle</span>
              <span data-lang-en>Width · height to scale</span>
            </p>
            <ul class="flash-sizes">
              {item.sizes.map((size) => (
                <li><span>{size.label}</span><span>{size.price}&nbsp;€</span></li>
              ))}
            </ul>
            {item.reserve ? (
              <p class="flash-reserved">
                <span data-lang-fr>Déjà réservé</span>
                <span data-lang-en>Already booked</span>
              </p>
            ) : (
              <a class="flash-cta" href={item.href}>
                <span data-lang-fr>Prendre rendez-vous</span>
                <span data-lang-en>Book an appointment</span>
              </a>
            )}
          </div>

        </li>
      ))}
    </ul>

  </section>

  <!-- Pop-up : visuel à gauche, infos à droite -->
  <dialog class="fm" aria-labelledby="fm-title">
    <div class="fm-box">
      <div class="fm-media slider" data-slider data-modal-slider>
        <div class="slider-track" data-track></div>
        <button class="slider-arrow slider-arrow--prev" type="button" aria-label="Image précédente" data-prev>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
        </button>
        <button class="slider-arrow slider-arrow--next" type="button" aria-label="Image suivante" data-next>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
        </button>
        <div class="slider-dots" aria-hidden="true" data-dots></div>
        <span class="flash-stamp" aria-hidden="true"><span data-lang-fr>Réservé</span><span data-lang-en>Booked</span></span>
      </div>

      <div class="fm-info">
        <h2 class="fm-title flash-name" id="fm-title"></h2>
        <p class="flash-sizes-note">
          <span data-lang-fr>Largeur · hauteur proportionnelle</span>
          <span data-lang-en>Width · height to scale</span>
        </p>
        <ul class="fm-sizes flash-sizes"></ul>
        <a class="fm-cta flash-cta" href="#">
          <span data-lang-fr>Prendre rendez-vous</span>
          <span data-lang-en>Book an appointment</span>
        </a>
        <p class="flash-reserved">
          <span data-lang-fr>Déjà réservé</span>
          <span data-lang-en>Already booked</span>
        </p>
      </div>

      <button class="fm-close" type="button" aria-label="Fermer">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </div>
  </dialog>

  <script type="application/json" id="flash-data" set:html={JSON.stringify(items)} />
</Base>

<style is:global>
  .flash {
    padding: clamp(2.5rem, 5vh, 5rem) var(--pad-x) 0;
  }

  /* ── En-tête ─────────────────────────────────────────────────── */

  .flash-head {
    max-width: 68ch;
    margin-bottom: clamp(2rem, 5vh, 4rem);
  }

  .flash-title {
    font-family: var(--font-henry);
    font-weight: 400;
    font-size: clamp(2.6rem, 7vw, 6.5rem);
    text-transform: uppercase;
    letter-spacing: var(--ls-tight);
    line-height: var(--lh-display);
    margin-bottom: 1.2rem;
  }

  .flash-intro + .flash-intro { margin-top: 1em; }

  .flash-intro {
    font-size: var(--size-body);
    line-height: var(--lh-body);
  }

  /* ── Mosaïque : 3 colonnes ───────────────────────────────────── */

  .flash-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem) clamp(1.5rem, 3vw, 3rem);
    max-width: 1240px;
    margin-inline: auto;
  }

  .flash-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* ── Carrousel (cartes + pop-up) ─────────────────────────────── */

  .slider {
    position: relative;
    aspect-ratio: 1;
    background: #f4efef; /* gris rosé clair */
    overflow: hidden;
  }

  .slider-track {
    display: flex;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  .slider-track::-webkit-scrollbar { display: none; }

  .slider-slide {
    flex: 0 0 100%;
    height: 100%;
    scroll-snap-align: start;
    border: none;
    padding: 0;
    background: none;
  }

  button.slider-slide { cursor: zoom-in; }

  .slider-slide img {
    padding: max(30px, 5%); /* marge : le modèle ne touche jamais le bord */
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .slider-arrow {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    width: 2.4rem;
    height: 2.4rem;
    display: grid;
    place-items: center;
    border: none;
    background: var(--accent);
    color: var(--accent-ink);
    cursor: pointer;
    opacity: 0;
    transition: opacity var(--t-fast);
  }

  .slider-arrow svg,
  .fm-close svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  .slider-arrow--prev { left: 0; }
  .slider-arrow--next { right: 0; }

  .slider:hover .slider-arrow,
  .slider-arrow:focus-visible { opacity: 1; }

  .slider-arrow[disabled],
  .slider-arrow[hidden] { opacity: 0 !important; pointer-events: none; }

  /* Écrans tactiles : pas de hover, flèches toujours visibles (le swipe marche aussi) */
  @media (hover: none) {
    .slider-arrow { opacity: 0.9; }
  }

  .slider-dots {
    position: absolute;
    bottom: 0.7rem;
    left: 50%;
    translate: -50% 0;
    display: flex;
    gap: 0.35rem;
    pointer-events: none;
  }

  .slider-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.3;
    transition: opacity var(--t-fast);
  }

  .slider-dot.is-active { opacity: 1; }

  .slider-dots[hidden] { display: none; }

  /* ── Infos (cartes + pop-up) ─────────────────────────────────── */

  .flash-info {
    padding-top: 1rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .flash-name {
    font-family: var(--font-henry);
    font-weight: 400;
    font-size: var(--size-other-title);
    text-transform: uppercase;
    line-height: 1;
    margin-bottom: 0.8rem;
  }

  .flash-sizes-note {
    font-size: var(--size-header);
    text-transform: uppercase;
    letter-spacing: var(--ls-caps);
    opacity: 0.6;
    margin-bottom: 0.5rem;
  }

  .flash-sizes {
    font-size: var(--size-header);
    text-transform: uppercase;
    letter-spacing: var(--ls-caps);
    margin-bottom: 1rem;
  }

  .flash-sizes li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.45rem 0;
    border-bottom: 1px solid rgba(237, 28, 36, 0.25);
  }

  .flash-sizes li:first-child {
    border-top: 1px solid rgba(237, 28, 36, 0.25);
  }

  .flash-cta {
    margin-top: auto;
    align-self: flex-start;
    padding: 0.5rem 0.9rem;
    background: rgba(0, 0, 0, 0.05);
    font-size: var(--size-header);
    text-transform: uppercase;
    letter-spacing: var(--ls-caps);
    transition: background var(--t-fast), color var(--t-fast);
  }

  .flash-cta:hover {
    background: var(--accent);
    color: var(--accent-ink);
  }

  /* ── Pop-up ──────────────────────────────────────────────────── */

  html.is-modal-open { overflow: hidden; }

  .fm {
    margin: auto;
    padding: 0;
    border: none;
    background: var(--bg);
    color: var(--text);
    width: min(1080px, 92vw, 170vh);
    max-height: 92vh;
    overflow: auto;
    overscroll-behavior: contain;
  }

  .fm::backdrop {
    background: rgba(17, 17, 17, 0.6);
  }

  .fm-box {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(15rem, 1fr);
  }

  .fm-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.5rem, 4vw, 3.5rem);
  }

  .fm-title {
    font-size: clamp(2rem, 4vw, 3.6rem);
    margin-bottom: 1.5rem;
  }

  .fm-sizes {
    font-size: var(--size-body);
    margin-bottom: 2rem;
  }

  .fm-cta {
    margin-top: 0;
    background: var(--accent);
    color: var(--accent-ink);
    padding: 0.75rem 1.2rem;
  }

  .fm-cta:hover { opacity: 0.8; }

  .fm-close {
    position: absolute;
    top: 0;
    right: 0;
    width: 2.6rem;
    height: 2.6rem;
    display: grid;
    place-items: center;
    border: none;
    background: none;
    color: var(--text);
    cursor: pointer;
  }

  .fm-close:hover { background: rgba(0, 0, 0, 0.05); }

  /* ── Modèle réservé ──────────────────────────────────────────── */

  .flash-stamp,
  .fm .flash-reserved { display: none; }

  .is-reserved .flash-stamp {
    display: block;
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    rotate: -12deg;
    padding: 0.5em 0.8em;
    /* La script a des marges internes asymétriques : on rogne la boîte
       à la hauteur des capitales pour un centrage optique réel */
    text-box: trim-both cap alphabetic;
    white-space: nowrap;
    border: 3px solid var(--accent);
    background: var(--bg);
    font-family: var(--font-henry);
    font-size: clamp(1.6rem, 3.2vw, 2.8rem);
    text-transform: uppercase;
    line-height: 1;
    color: var(--text);
    pointer-events: none;
  }

  .is-reserved .slider-slide img {
    opacity: 0.35;
    filter: grayscale(1);
  }

  .is-reserved .flash-sizes { opacity: 0.4; text-decoration: line-through; }

  .fm.is-reserved .fm-cta { display: none; }
  .fm.is-reserved .flash-reserved { display: block; }

  .flash-reserved {
    margin-top: auto;
    align-self: flex-start;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--accent);
    font-size: var(--size-header);
    text-transform: uppercase;
    letter-spacing: var(--ls-caps);
  }

  .fm .flash-reserved { margin-top: 0; padding: 0.75rem 1.2rem; }

  /* ── Responsive ──────────────────────────────────────────────── */

  @media (max-width: 900px) {
    .flash-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 720px) {
    .fm { width: 100vw; max-width: 100vw; max-height: 100dvh; }
    .fm-box { grid-template-columns: 1fr; }
    .fm-info { padding: 1.5rem var(--pad-x) 2rem; }
    .fm-close { background: var(--bg); }
  }

  @media (max-width: 560px) {
    .flash-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  interface Item {
    title: string;
    href: string;
    images: { src: string; alt: string }[];
    sizes: { label: string; price: number }[];
    reserve: boolean;
  }

  const items: Item[] = JSON.parse(document.getElementById('flash-data')!.textContent!);

  /* Carrousel : flèches + points, le nombre d'images est relu à chaque fois
     (la pop-up change de contenu à chaque ouverture). */
  function initSlider(slider: HTMLElement) {
    const track = slider.querySelector<HTMLElement>('[data-track]')!;
    const prev  = slider.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next  = slider.querySelector<HTMLButtonElement>('[data-next]')!;
    const dots  = slider.querySelector<HTMLElement>('[data-dots]')!;

    const index = () => Math.round(track.scrollLeft / (track.clientWidth || 1));
    const go = (i: number, behavior: ScrollBehavior = 'smooth') =>
      track.scrollTo({ left: i * track.clientWidth, behavior });

    const update = () => {
      const count = track.children.length;
      const i = index();
      Array.from(dots.children).forEach((d, n) => d.classList.toggle('is-active', n === i));
      prev.hidden = next.hidden = dots.hidden = count < 2;
      prev.disabled = i === 0;
      next.disabled = i >= count - 1;
    };

    prev.addEventListener('click', () => go(index() - 1));
    next.addEventListener('click', () => go(index() + 1));
    track.addEventListener('scroll', update, { passive: true });
    update();

    return { go, update };
  }

  document.querySelectorAll<HTMLElement>('[data-slider]:not([data-modal-slider])').forEach(initSlider);

  /* ── Pop-up ── */
  const dialog  = document.querySelector<HTMLDialogElement>('.fm')!;
  const mSlider = dialog.querySelector<HTMLElement>('[data-modal-slider]')!;
  const mTrack  = mSlider.querySelector<HTMLElement>('[data-track]')!;
  const mDots   = mSlider.querySelector<HTMLElement>('[data-dots]')!;
  const mTitle  = dialog.querySelector<HTMLElement>('.fm-title')!;
  const mSizes  = dialog.querySelector<HTMLElement>('.fm-sizes')!;
  const mCta    = dialog.querySelector<HTMLAnchorElement>('.fm-cta')!;
  const modal   = initSlider(mSlider);

  const el = (tag: string, cls?: string, text?: string) => {
    const node = document.createElement(tag);
    if (cls) node.className = cls;
    if (text) node.textContent = text;
    return node;
  };

  function open(idx: number, start: number) {
    const item = items[idx];

    mTrack.replaceChildren(...item.images.map((img) => {
      const slide = el('div', 'slider-slide');
      const image = document.createElement('img');
      image.src = img.src;
      image.alt = img.alt;
      slide.append(image);
      return slide;
    }));
    mDots.replaceChildren(...item.images.map(() => el('span', 'slider-dot')));
    mSizes.replaceChildren(...item.sizes.map((s) => {
      const li = el('li');
      li.append(el('span', '', s.label), el('span', '', `${s.price} €`));
      return li;
    }));
    mTitle.textContent = item.title;
    mCta.href = item.href;
    dialog.classList.toggle('is-reserved', item.reserve);

    document.documentElement.classList.add('is-modal-open');
    dialog.showModal();
    modal.go(start, 'instant');
    modal.update();
  }

  document.querySelectorAll<HTMLElement>('[data-open]').forEach((btn) =>
    btn.addEventListener('click', () => open(Number(btn.dataset.open), Number(btn.dataset.index)))
  );

  dialog.querySelector('.fm-close')!.addEventListener('click', () => dialog.close());
  // Clic sur le fond (hors de la boîte) → fermer
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  dialog.addEventListener('close', () => document.documentElement.classList.remove('is-modal-open'));
  // Le scroll "premium" de Base.astro intercepte la molette sur window : on la garde dans la pop-up
  dialog.addEventListener('wheel', (e) => e.stopPropagation());

  dialog.addEventListener('keydown', (e) => {
    const i = Math.round(mTrack.scrollLeft / (mTrack.clientWidth || 1));
    if (e.key === 'ArrowLeft')  modal.go(i - 1);
    if (e.key === 'ArrowRight') modal.go(i + 1);
  });
</script>
